# Runtime modes
# SaaS production: SIGNUP_MODE=open lets each new client create an isolated workspace.
DATA_BACKEND=memory
AI_MODE=mock
AUTH_MODE=preview
AUTH_SECRET=
INTEGRATION_ENCRYPTION_KEY=
SIGNUP_MODE=open
ALLOW_SHARED_ENV_INTEGRATIONS=false
DEFAULT_WORKSPACE_NAME=AI Marketing OS
DEFAULT_BRAND_NAME=Lioness Walk
DEFAULT_BRAND_ID=brand_lioness_walk

# Optional first production admin created by npm run db:seed
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# AI
OPENAI_API_KEY=

# PostgreSQL / Prisma
# Production: set DATA_BACKEND=postgres and AUTH_MODE=database, then run npm run db:deploy && npm run db:seed.
DATABASE_URL=postgresql://user:password@localhost:5432/marketing_os?schema=public

# Meta / Instagram / Facebook
# OAuth-backed connection requires META_APP_ID + META_APP_SECRET + DATA_BACKEND=postgres
# and AUTH_SECRET or INTEGRATION_ENCRYPTION_KEY.
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_AD_ACCOUNT_ID=
# Optional shared static-token fallback. Keep ALLOW_SHARED_ENV_INTEGRATIONS=false in multi-workspace production.
META_PAGE_ACCESS_TOKEN=
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_NAME=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_USERNAME=

# LinkedIn
# OAuth connection uses OpenID/profile/email + w_member_social. Set LINKEDIN_REQUEST_ORGANIZATION_SCOPE=true
# only after your LinkedIn app has organization publishing access.
LINKEDIN_API_VERSION=202608
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REQUEST_ORGANIZATION_SCOPE=false
LINKEDIN_ORGANIZATION_URN=
# Optional shared static-token fallback.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_AUTHOR_ID=
LINKEDIN_ACCOUNT_LABEL=

# X
# OAuth 2.0 PKCE connection for direct text/link publishing.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional shared static-token fallback. Keep ALLOW_SHARED_ENV_INTEGRATIONS=false in multi-workspace production.
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_USER_ID=
X_USERNAME=
X_ACCOUNT_LABEL=

# TikTok
# Content Posting API Direct Post requires user.info.basic + video.publish approval.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional shared static-token fallback.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_ACCOUNT_LABEL=

# YouTube
# OAuth connection requests youtube.upload + youtube.readonly and stores refresh tokens securely.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_DEFAULT_CATEGORY_ID=22
# Server-side URL transfer safety limit; default is 50 MiB if omitted.
YOUTUBE_MAX_SERVER_UPLOAD_BYTES=52428800
# Optional shared static-token fallback.
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_TITLE=

# Pinterest
# OAuth requires boards:read, pins:read, pins:write and user_accounts:read for direct image Pin publishing.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Optional shared static-token fallback.
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_USERNAME=

# Scheduler
# The primary 5-minute GitHub Actions scheduler authenticates with GitHub OIDC; no shared secret is required.
# Optional: set CRON_SECRET only for the daily Vercel Cron/shared-secret fallback.
CRON_SECRET=
# Number of due posts processed per scheduler invocation. Clamped to 1..20; default 5.
SCHEDULER_BATCH_SIZE=5
# Optional GitHub repository variable SCHEDULER_APP_URL overrides the default production URL.
# PRODUCTION_APP_URL can also be used by both scheduler and smoke workflows.

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=


# Billing / payments
# Payments are optional and deferred by default until a production gateway is selected.
PAYMENTS_ENABLED=false
# Legacy Stripe adapter remains available as an optional provider implementation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_SCALE_MONTHLY=
# Display labels are presentation-only and do not control what Stripe charges.
BILLING_STARTER_DISPLAY_PRICE=
BILLING_GROWTH_DISPLAY_PRICE=
BILLING_SCALE_DISPLAY_PRICE=
# Canonical monthly amounts are used only for agency MRR reporting. They do not control Stripe charges.
BILLING_STARTER_MONTHLY_AMOUNT_INR=
BILLING_GROWTH_MONTHLY_AMOUNT_INR=
BILLING_SCALE_MONTHLY_AMOUNT_INR=
# Limits and feature entitlements remain informational until enforcement is explicitly enabled.
BILLING_ENFORCE_LIMITS=false
BILLING_ENFORCE_ENTITLEMENTS=false
BILLING_STARTER_MEMBER_LIMIT=
BILLING_STARTER_SOCIAL_CONNECTION_LIMIT=
BILLING_STARTER_SOCIAL_POST_LIMIT_MONTHLY=
BILLING_GROWTH_MEMBER_LIMIT=
BILLING_GROWTH_SOCIAL_CONNECTION_LIMIT=
BILLING_GROWTH_SOCIAL_POST_LIMIT_MONTHLY=
BILLING_SCALE_MEMBER_LIMIT=
BILLING_SCALE_SOCIAL_CONNECTION_LIMIT=
BILLING_SCALE_SOCIAL_POST_LIMIT_MONTHLY=
# Optional canonical public origin for OAuth and billing return URLs.
NEXT_PUBLIC_APP_URL=

# GitHub Actions production smoke monitoring
# Optional repository variable PRODUCTION_APP_URL overrides the default https://ai-marketing-os.vercel.app target.
# This is a GitHub repository variable, not a runtime secret.

# Vercel Deployment Protection automation
# If Vercel Authentication protects production, generate a Protection Bypass for Automation value
# and add the same value to GitHub Actions as repository secret VERCEL_AUTOMATION_BYPASS_SECRET.
# Do not commit the secret to this file.
