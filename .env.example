# Runtime modes
DATA_BACKEND=memory
AI_MODE=mock
AUTH_MODE=preview
AUTH_SECRET=
INTEGRATION_ENCRYPTION_KEY=
DEV_USER_EMAIL=owner@example.com
DEV_USER_ROLE=admin
DEFAULT_BRAND_ID=brand_lioness_walk

# AI
OPENAI_API_KEY=

# PostgreSQL / Prisma (required for production OAuth-backed integrations)
DATABASE_URL=postgresql://user:password@localhost:5432/marketing_os?schema=public

# Meta / Instagram / Facebook
# OAuth-backed connection requires META_APP_ID + META_APP_SECRET + DATA_BACKEND=postgres
# and AUTH_SECRET or INTEGRATION_ENCRYPTION_KEY.
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_AD_ACCOUNT_ID=
# Optional static-token fallback when OAuth storage is not being used.
META_PAGE_ACCESS_TOKEN=
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_NAME=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_USERNAME=

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_ID=

# X
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# TikTok
TIKTOK_ACCESS_TOKEN=

# YouTube
YOUTUBE_ACCESS_TOKEN=

# Pinterest
PINTEREST_ACCESS_TOKEN=

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
