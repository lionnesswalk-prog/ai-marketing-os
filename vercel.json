{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/.next",
  "crons": [
    {
      "path": "/api/scheduler/publish-social",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/scheduler/weekly-performance-review",
      "schedule": "20 2 * * *"
    }
  ]
}
