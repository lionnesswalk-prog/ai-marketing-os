generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String          @id @default(cuid())
  name      String
  createdAt DateTime        @default(now())
  brands    Brand[]
  accesses  WorkspaceAccess[]
  invites   WorkspaceInvite[]
  subscription WorkspaceSubscription?
}

model Brand {
  id           String                  @id @default(cuid())
  workspaceId  String
  name         String
  voiceJson    Json?
  createdAt    DateTime                @default(now())
  workspace    Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]
  leads        Lead[]
  approvals    Approval[]
  socialPosts  SocialPost[]
  integrations IntegrationConnection[]
  auditLogs    AuditLog[]
  insights     MarketingInsight[]
  knowledgeItems KnowledgeItem[]
  copilotMessages BrandCopilotMessage[]
  assets BrandAsset[]
  contentCalendarPlans ContentCalendarPlan[]
  performanceSnapshots ContentPerformanceSnapshot[]
  performanceReviews WeeklyPerformanceReview[]

  @@index([workspaceId])
}

model WorkspaceUser {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String?
  passwordHash    String?
  isPlatformAdmin Boolean           @default(false)
  sessionVersion  Int               @default(0)
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?
  createdAt       DateTime          @default(now())
  accesses        WorkspaceAccess[]
  accountTokens   AccountToken[]
}

model AccountToken {
  id        String        @id @default(cuid())
  userId    String
  type      String
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      WorkspaceUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
}

model WorkspaceAccess {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        String
  createdAt   DateTime      @default(now())
  user        WorkspaceUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email, expiresAt])
}

model Campaign {
  id          String               @id @default(cuid())
  brandId     String
  externalId  String?
  channel     String
  name        String
  status      String
  dailyBudget Decimal?             @db.Decimal(12, 2)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  brand       Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  metrics     CampaignMetric[]
  actions     OptimizationAction[]

  @@index([brandId, channel])
  @@unique([brandId, channel, externalId])
}

model CampaignMetric {
  id          String   @id @default(cuid())
  campaignId  String
  capturedAt  DateTime @default(now())
  spend       Decimal  @db.Decimal(12, 2)
  impressions Int
  clicks      Int
  conversions Int
  revenue     Decimal  @db.Decimal(12, 2)
  frequency   Decimal? @db.Decimal(8, 3)
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, capturedAt])
}

model OptimizationAction {
  id             String    @id @default(cuid())
  campaignId     String
  type           String
  reason         String
  confidence     Decimal   @db.Decimal(5, 4)
  spendImpactPct Decimal?  @db.Decimal(6, 2)
  status         String    @default("proposed")
  createdAt      DateTime  @default(now())
  executedAt     DateTime?
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  approval       Approval?

  @@index([campaignId, status])
}

model Approval {
  id          String             @id @default(cuid())
  brandId     String
  actionId    String             @unique
  status      String             @default("pending")
  requestedAt DateTime           @default(now())
  decidedAt   DateTime?
  decidedBy   String?
  brand       Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  action      OptimizationAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([brandId, status])
}

model Lead {
  id         String        @id @default(cuid())
  brandId    String
  externalId String?
  source     String
  name       String?
  message    String
  intent     String
  status     String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  brand      Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  messages   LeadMessage[]

  @@index([brandId, status, intent])
}

model LeadMessage {
  id        String   @id @default(cuid())
  leadId    String
  direction String
  body      String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model SocialPost {
  id           String    @id @default(cuid())
  brandId      String
  platform     String
  contentType  String
  title        String
  caption      String
  status       String    @default("draft")
  scheduledAt  DateTime?
  externalId   String?
  metadataJson Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  brand        Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  performanceSnapshot ContentPerformanceSnapshot?

  @@index([brandId, status, scheduledAt])
}

model MarketingInsight {
  id         String   @id @default(cuid())
  brandId    String
  kind       String
  title      String
  detail     String
  severity   String
  evidence   Json?
  createdAt  DateTime @default(now())
  resolvedAt DateTime?
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, resolvedAt, createdAt])
}

model KnowledgeItem {
  id         String   @id @default(cuid())
  brandId    String
  title      String
  kind       String   @default("reference")
  content    String
  sourceUrl  String?
  verified   Boolean  @default(false)
  verifiedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, verified, updatedAt])
}

model WeeklyPerformanceReview {
  id           String   @id @default(cuid())
  brandId      String
  periodKey    String
  periodEnd    DateTime
  aiMode       String?
  evidenceJson Json
  reviewJson   Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, periodKey])
  @@index([brandId, periodEnd])
}

model ContentPerformanceSnapshot {
  id                String     @id @default(cuid())
  brandId           String
  socialPostId      String     @unique
  providerContentId String
  platform          String
  theme             String?
  headline          String
  publishedAt       DateTime?
  metricsJson       Json
  engagementScore   Float
  capturedAt        DateTime   @default(now()) @updatedAt
  brand             Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialPost        SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)

  @@index([brandId, platform, capturedAt])
  @@index([providerContentId])
}

model ContentCalendarPlan {
  id          String                @id @default(cuid())
  brandId     String
  horizonDays Int
  objective   String
  focus       String?
  aiMode      String?
  timingJson  Json?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  brand       Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  items       ContentCalendarItem[]

  @@index([brandId, createdAt])
}

model ContentCalendarItem {
  id              String              @id @default(cuid())
  planId          String
  dayOffset       Int
  platform        String
  theme           String
  headline        String
  subheadline     String
  caption         String
  cta             String
  hashtags        Json?
  visualDirection String
  postingWindow   String
  timingReason    String
  timingEvidence  String
  socialPostId    String?             @unique
  createdAt       DateTime            @default(now())
  plan            ContentCalendarPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, dayOffset])
}

model BrandAsset {
  id        String   @id @default(cuid())
  brandId   String
  kind      String   @default("product_image")
  fileName  String
  mimeType  String
  width     Int?
  height    Int?
  data      Bytes
  createdAt DateTime @default(now())
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
}

model BrandCopilotMessage {
  id        String   @id @default(cuid())
  brandId   String
  userId    String?
  role      String
  content   String
  mode      String?
  createdAt DateTime @default(now())
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
}

model IntegrationConnection {
  id                String   @id @default(cuid())
  brandId           String
  provider          String
  externalAccountId String?
  status            String   @default("disconnected")
  metadataJson      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  brand             Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, provider])
}

model AuditLog {
  id         String   @id @default(cuid())
  brandId    String
  actorType  String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  payload    Json?
  createdAt  DateTime @default(now())
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
}


model WorkspaceSubscription {
  id                   String    @id @default(cuid())
  workspaceId          String    @unique
  provider             String    @default("stripe")
  planKey              String    @default("starter")
  status               String    @default("inactive")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, planKey])
}

model BillingWebhookEvent {
  eventId     String    @id
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([receivedAt])
}


model AuthThrottle {
  key          String    @id
  attempts     Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([blockedUntil])
}


model SchedulerInvocation {
  id         String   @id @default(cuid())
  source     String
  status     String
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  durationMs Int?
  claimed    Int      @default(0)
  published  Int      @default(0)
  processing Int      @default(0)
  failed     Int      @default(0)
  recovered  Int      @default(0)
  error      String?

  @@index([startedAt])
}
