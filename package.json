{
  "name": "ai-marketing-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/web && next dev",
    "build": "cd apps/web && next build",
    "typecheck": "tsc --noEmit",
    "test:core": "tsx tests/core.test.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed.ts",
    "postinstall": "prisma generate",
    "test:billing": "tsx tests/billing.test.ts",
    "test": "npm run test:core && npm run test:billing && npm run test:operations && npm run test:runtime && npm run test:scheduler && npm run test:github-scheduler-oidc && npm run test:provider-diagnostics && npm run test:social-preflight && npm run test:provider-processing && npm run test:security-qa && npm run test:runtime-health && npm run test:observability && npm run test:security-hardening && npm run test:ai-runtime && npm run test:runtime-consistency && npm run test:provider-runtime && npm run test:launch-readiness && npm run test:meta-page-selection && npm run test:linkedin-x-stability",
    "test:operations": "tsx tests/operations.test.ts",
    "test:runtime": "tsx tests/runtime.test.ts",
    "test:scheduler": "tsx tests/scheduler.test.ts",
    "test:provider-diagnostics": "tsx tests/provider-diagnostics.test.ts",
    "test:social-preflight": "tsx tests/social-preflight.test.ts",
    "test:provider-processing": "tsx tests/provider-processing-status.test.ts",
    "test:security-qa": "tsx tests/security-qa.test.ts",
    "test:runtime-health": "tsx tests/runtime-health.test.ts",
    "test:github-scheduler-oidc": "tsx tests/github-scheduler-oidc.test.ts",
    "test:observability": "tsx tests/request-observability.test.ts",
    "test:security-hardening": "tsx tests/security-hardening.test.ts",
    "test:database-auth": "tsx tests/database-auth-integration.test.ts",
    "test:seed-bootstrap": "tsx tests/seed-bootstrap.test.ts",
    "test:durable-scheduler-db": "tsx tests/durable-scheduler-db.test.ts",
    "test:ai-runtime": "tsx tests/ai-runtime-fallback.test.ts",
    "test:runtime-consistency": "tsx tests/production-runtime-consistency.test.ts",
    "test:provider-runtime": "tsx tests/provider-runtime-consistency.test.ts",
    "test:launch-readiness": "tsx tests/launch-readiness.test.ts",
    "test:meta-page-selection": "tsx tests/meta-page-selection.test.ts",
    "test:linkedin-x-stability": "tsx tests/linkedin-x-stability.test.ts"
  },
  "dependencies": {
    "@openai/agents": "0.18.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.3.5",
    "openai": "7.15.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2",
    "workflow": "4.8.8"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
