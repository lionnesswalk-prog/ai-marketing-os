{
  "name": "ai-marketing-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev apps/web",
    "build": "next build apps/web",
    "typecheck": "tsc --noEmit",
    "test:core": "tsx tests/core.test.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed.ts",
    "postinstall": "prisma generate",
    "test:billing": "tsx tests/billing.test.ts",
    "test": "npm run test:core && npm run test:billing && npm run test:operations && npm run test:runtime && npm run test:scheduler && npm run test:github-scheduler-oidc && npm run test:provider-diagnostics && npm run test:social-preflight && npm run test:provider-processing && npm run test:security-qa && npm run test:runtime-health && npm run test:observability && npm run test:security-hardening",
    "test:operations": "tsx tests/operations.test.ts",
    "test:runtime": "tsx tests/runtime.test.ts",
    "test:scheduler": "tsx tests/scheduler.test.ts",
    "test:provider-diagnostics": "tsx tests/provider-diagnostics.test.ts",
    "test:social-preflight": "tsx tests/social-preflight.test.ts",
    "test:provider-processing": "tsx tests/provider-processing-status.test.ts",
    "test:security-qa": "tsx tests/security-qa.test.ts",
    "test:runtime-health": "tsx tests/runtime-health.test.ts",
    "test:github-scheduler-oidc": "tsx tests/github-scheduler-oidc.test.ts",
    "test:observability": "tsx tests/request-observability.test.ts",
    "test:security-hardening": "tsx tests/security-hardening.test.ts"
  },
  "dependencies": {
    "@openai/agents": "0.18.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.3.5",
    "openai": "7.15.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
