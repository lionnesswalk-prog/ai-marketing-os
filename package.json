{
  "name": "ai-marketing-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev apps/web",
    "build": "next build apps/web",
    "typecheck": "tsc --noEmit",
    "test:core": "tsx tests/core.test.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed.ts",
    "postinstall": "prisma generate",
    "test:billing": "tsx tests/billing.test.ts",
    "test": "npm run test:core && npm run test:billing && npm run test:operations && npm run test:runtime && npm run test:scheduler && npm run test:provider-diagnostics && npm run test:social-preflight && npm run test:provider-processing",
    "test:operations": "tsx tests/operations.test.ts",
    "test:runtime": "tsx tests/runtime.test.ts",
    "test:scheduler": "tsx tests/scheduler.test.ts",
    "test:provider-diagnostics": "tsx tests/provider-diagnostics.test.ts",
    "test:social-preflight": "tsx tests/social-preflight.test.ts",
    "test:provider-processing": "tsx tests/provider-processing-status.test.ts"
  },
  "dependencies": {
    "@openai/agents": "latest",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "latest",
    "openai": "latest",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prisma": "7.10.0",
    "tsx": "latest",
    "typescript": "latest"
  }
}
